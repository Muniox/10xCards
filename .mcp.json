{
    "mcpServers": {
        "chrome-devtools": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "chrome-devtools-mcp@latest"
            ],
            "env": {}
        },
        "gemini-cli": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "gemini-mcp-tool"
            ],
            "env": {}
        }
    }
}