---
import Layout from "./Layout.astro";
import Navigation from "../components/Navigation.astro";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;

// TEMPORARY: Authentication disabled for development/testing
// TODO: Re-enable authentication before production
// const { data: { session } } = await Astro.locals.supabase.auth.getSession();
// if (!session) {
//   return Astro.redirect("/");
// }

// Pobierz aktualną ścieżkę dla aktywnych linków w nawigacji
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
  <div class="min-h-screen flex flex-col">
    <!-- Navigation Bar -->
    <Navigation currentPath={currentPath} />

    <!-- Main Content -->
    <main class="flex-1 bg-gray-50">
      <slot />
    </main>
  </div>
</Layout>
