---
// Footer component for Landing Page
---

<footer class="footer w-full border-t bg-background py-8">
  <div class="container">
    <div class="footer-content grid gap-8 sm:grid-cols-2 sm:gap-x-12 lg:gap-x-24">
      <div class="footer-brand">
        <div class="footer-logo mb-2 flex items-center gap-2 text-lg font-semibold">
          <span class="text-2xl" aria-hidden="true">🎴</span>
          <span>10xCards</span>
        </div>
        <p class="text-sm text-muted-foreground">
          Ucz się szybciej z pomocą AI
        </p>
      </div>

      <div class="footer-links sm:justify-self-end">
        <h4 class="mb-2 text-sm font-semibold">Prawne</h4>
        <ul class="space-y-1.5 text-sm">
          <li>
            <a
              href="/privacy"
              class="text-muted-foreground transition-colors hover:text-foreground"
            >
              Polityka prywatności
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="text-muted-foreground transition-colors hover:text-foreground"
            >
              Regulamin
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-6 w-full border-t">
    <div class="container pt-6">
      <p class="text-center text-sm text-muted-foreground">
        &copy; 2025 10xCards. Wszelkie prawa zastrzeżone.
      </p>
    </div>
  </div>
</footer>
