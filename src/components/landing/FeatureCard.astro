---
interface Props {
  icon: string;        // Emoji lub ikona (np. "✨")
  title: string;       // Tytuł funkcji (np. "Generowanie przez AI")
  description: string; // Opis funkcji
}

const { icon, title, description } = Astro.props;
---

<div class="feature-card group rounded-lg border bg-card p-6 text-card-foreground shadow-sm transition-all hover:shadow-md">
  <div class="feature-icon mb-4 text-4xl" aria-hidden="true">
    {icon}
  </div>
  <h3 class="feature-title mb-2 text-xl font-semibold">
    {title}
  </h3>
  <p class="feature-description text-muted-foreground">
    {description}
  </p>
</div>
