### 8.1 List Generations - GET /api/generations
# @name listGenerations
GET {{baseUrl}}/api/generations HTTP/1.1

### 8.2 List Generations - With Pagination
GET {{baseUrl}}/api/generations?page=1&limit=5 HTTP/1.1

### 8.3 List Generations - Second Page
GET {{baseUrl}}/api/generations?page=2&limit=10 HTTP/1.1

###############################################################################

### 9.1 Get Generation Statistics - GET /api/generations/statistics
# @name getStatistics
GET {{baseUrl}}/api/generations/statistics HTTP/1.1

### 9.2 Get Statistics - Last Week
GET {{baseUrl}}/api/generations/statistics?period=week HTTP/1.1

### 9.3 Get Statistics - Last Month
GET {{baseUrl}}/api/generations/statistics?period=month HTTP/1.1

### 9.4 Get Statistics - All Time
GET {{baseUrl}}/api/generations/statistics?period=all HTTP/1.1

### 9.5 Get Statistics - Invalid Period (should fail)
GET {{baseUrl}}/api/generations/statistics?period=invalid HTTP/1.1

###############################################################################
# 3. ERROR SCENARIOS & EDGE CASES
###############################################################################

### 10.1 Invalid Method
PUT {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "This should fail",
  "back": "PUT not supported"
}

### 10.2 Invalid Content-Type
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: text/plain

This is not JSON

### 10.3 Malformed JSON
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "Missing closing quote,
  "back": "Invalid JSON"
}

### 10.4 SQL Injection Attempt (should be sanitized)
GET {{baseUrl}}/api/flashcards?source='; DROP TABLE flashcards;-- HTTP/1.1

### 10.5 XSS Attempt in Flashcard (should be sanitized)
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "<script>alert('XSS')</script>",
  "back": "<img src=x onerror=alert('XSS')>"
}

### 10.6 Pagination - Negative Page Number (should fail)
GET {{baseUrl}}/api/flashcards?page=-1 HTTP/1.1

### 10.7 Pagination - Limit Exceeds Maximum (should fail)
GET {{baseUrl}}/api/flashcards?limit=999 HTTP/1.1

### 10.8 Invalid ID Format
GET {{baseUrl}}/api/flashcards/abc HTTP/1.1

###############################################################################
# 4. COMPLETE WORKFLOW TEST
###############################################################################

### 11.1 Complete Workflow - Step 1: Generate Flashcards
# @name workflowGenerate
POST {{baseUrl}}/api/generations HTTP/1.1
Content-Type: application/json

{
  "source_text": "The Pomodoro Technique is a time management method developed by Francesco Cirillo in the late 1980s. The technique uses a timer to break down work into intervals, traditionally 25 minutes in length, separated by short breaks. Each interval is known as a pomodoro, from the Italian word for 'tomato', after the tomato-shaped kitchen timer that Cirillo used as a university student. The method is based on the idea that frequent breaks can improve mental agility. There are six steps in the original technique: 1) Decide on the task to be done, 2) Set the pomodoro timer (traditionally to 25 minutes), 3) Work on the task, 4) End work when the timer rings and put a checkmark on a piece of paper, 5) If you have fewer than four checkmarks, take a short break (3–5 minutes), then go to step 2, 6) After four pomodoros, take a longer break (15–30 minutes), reset your checkmark count to zero, then go to step 1. The Pomodoro Technique has been widely popularized by dozens of apps and websites providing timers and instructions. Closely related to concepts such as timeboxing and iterative and incremental development used in software design, the method has been adopted in pair programming contexts.",
  "model": "openai/gpt-3.5-turbo"
}

### 11.2 Complete Workflow - Step 2: Review Generated Suggestions
GET {{baseUrl}}/api/generations/{{workflowGenerate.response.body.$.generation_id}} HTTP/1.1

### 11.3 Complete Workflow - Step 3: Accept Some Flashcards
# @name workflowBulkCreate
POST {{baseUrl}}/api/flashcards/bulk HTTP/1.1
Content-Type: application/json

{
  "generation_id": {{workflowGenerate.response.body.$.generation_id}},
  "flashcards": [
    {
      "front": "What is the Pomodoro Technique?",
      "back": "A time management method that uses a timer to break work into intervals, traditionally 25 minutes in length, separated by short breaks",
      "source": "ai-full"
    },
    {
      "front": "Who developed the Pomodoro Technique and when?",
      "back": "Francesco Cirillo in the late 1980s",
      "source": "ai-edited"
    },
    {
      "front": "How long is a traditional pomodoro interval?",
      "back": "25 minutes",
      "source": "ai-full"
    }
  ]
}

### 11.4 Complete Workflow - Step 4: List All Flashcards
GET {{baseUrl}}/api/flashcards HTTP/1.1

### 11.5 Complete Workflow - Step 5: Get Statistics
GET {{baseUrl}}/api/generations/statistics HTTP/1.1

### 11.6 Complete Workflow - Step 6: Update a Flashcard
PATCH {{baseUrl}}/api/flashcards/{{workflowBulkCreate.response.body.$.flashcards[0].id}} HTTP/1.1
Content-Type: application/json

{
  "back": "A time management method developed by Francesco Cirillo that uses a timer to break work into 25-minute intervals called pomodoros, separated by short breaks to improve mental agility"
}

### 11.7 Complete Workflow - Step 7: Get Updated Flashcard
GET {{baseUrl}}/api/flashcards/{{workflowBulkCreate.response.body.$.flashcards[0].id}} HTTP/1.1

### 11.8 Complete Workflow - Step 8: Filter Flashcards by Generation
GET {{baseUrl}}/api/flashcards?generation_id={{workflowGenerate.response.body.$.generation_id}} HTTP/1.1

### 11.9 Complete Workflow - Step 9: Create Manual Flashcard
# @name workflowManual
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "What are the benefits of the Pomodoro Technique?",
  "back": "Improved focus, reduced mental fatigue, better time awareness, and increased productivity through structured work intervals"
}

### 11.10 Complete Workflow - Step 10: Filter by Source (manual)
GET {{baseUrl}}/api/flashcards?source=manual HTTP/1.1

