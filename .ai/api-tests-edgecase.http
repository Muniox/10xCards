# 10xCards REST API Tests
# Test User ID: 00000000-0000-0000-0000-000000000000
# Base URL: http://localhost:3000

@baseUrl = http://localhost:3000
@testUserId = 00000000-0000-0000-0000-000000000000

###############################################################################
# 1. FLASHCARD ENDPOINTS
###############################################################################

### 1.1 List Flashcards - GET /api/flashcards
# @name listFlashcards
GET {{baseUrl}}/api/flashcards HTTP/1.1

### 1.2 List Flashcards - With Pagination
GET {{baseUrl}}/api/flashcards?page=1&limit=10 HTTP/1.1

### 1.3 List Flashcards - Filter by Source
GET {{baseUrl}}/api/flashcards?source=manual HTTP/1.1

### 1.4 List Flashcards - Filter by Generation ID
GET {{baseUrl}}/api/flashcards?generation_id=1 HTTP/1.1

### 1.5 List Flashcards - Combined Filters
GET {{baseUrl}}/api/flashcards?page=1&limit=5&source=ai-full HTTP/1.1

###############################################################################

### 2.1 Get Single Flashcard - GET /api/flashcards/:id
# @name getFlashcard
GET {{baseUrl}}/api/flashcards/1 HTTP/1.1

### 2.2 Get Non-existent Flashcard (should return 404)
GET {{baseUrl}}/api/flashcards/99999 HTTP/1.1

###############################################################################

### 3.1 Create Manual Flashcard - POST /api/flashcards
# @name createFlashcard
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "What is spaced repetition?",
  "back": "A learning technique that involves reviewing information at increasing intervals to improve long-term retention"
}

### 3.2 Create Another Manual Flashcard
# @name createFlashcard2
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "What is active recall?",
  "back": "A learning principle where you actively stimulate memory during the learning process"
}

### 3.3 Create Flashcard - Test Validation (empty front - should fail)
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "",
  "back": "This should fail validation"
}

### 3.4 Create Flashcard - Test Validation (too long front - should fail)
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
  "back": "This front text is too long"
}

### 3.5 Create Flashcard - Test Validation (missing back - should fail)
POST {{baseUrl}}/api/flashcards HTTP/1.1
Content-Type: application/json

{
  "front": "Missing back field"
}

###############################################################################

### 4.1 Update Flashcard - PATCH /api/flashcards/:id
# Note: Replace :id with actual flashcard ID from previous responses
# @name updateFlashcard
PATCH {{baseUrl}}/api/flashcards/{{createFlashcard.response.body.$.id}} HTTP/1.1
Content-Type: application/json

{
  "front": "What is spaced repetition learning?",
  "back": "A learning technique that involves reviewing information at systematically increasing intervals to improve long-term retention"
}

### 4.2 Update Flashcard - Only Front
PATCH {{baseUrl}}/api/flashcards/{{createFlashcard.response.body.$.id}} HTTP/1.1
Content-Type: application/json

{
  "front": "Updated front only"
}

### 4.3 Update Flashcard - Only Back
PATCH {{baseUrl}}/api/flashcards/{{createFlashcard.response.body.$.id}} HTTP/1.1
Content-Type: application/json

{
  "back": "Updated back only"
}

### 4.4 Update Flashcard - No Fields (should fail)
PATCH {{baseUrl}}/api/flashcards/{{createFlashcard.response.body.$.id}} HTTP/1.1
Content-Type: application/json

{}

### 4.5 Update Non-existent Flashcard (should return 404)
PATCH {{baseUrl}}/api/flashcards/99999 HTTP/1.1
Content-Type: application/json

{
  "front": "This won't work"
}

###############################################################################

### 5.1 Delete Flashcard - DELETE /api/flashcards/:id
# @name deleteFlashcard
DELETE {{baseUrl}}/api/flashcards/{{createFlashcard2.response.body.$.id}} HTTP/1.1

### 5.2 Delete Non-existent Flashcard (should return 404)
DELETE {{baseUrl}}/api/flashcards/99999 HTTP/1.1

###############################################################################
# 2. AI GENERATION ENDPOINTS
###############################################################################

### 6.1 Generate Flashcard Suggestions - POST /api/generations
# @name generateFlashcards
POST {{baseUrl}}/api/generations HTTP/1.1
Content-Type: application/json

{
  "source_text": "Spaced repetition is a learning technique that incorporates increasing intervals of time between subsequent review of previously learned material in order to exploit the psychological spacing effect. The spacing effect refers to the phenomenon whereby learning is greater when studying is spread out over time, as opposed to studying the same amount of content in a single session. Alternative names include spaced rehearsal, expanding rehearsal, graduated intervals, repetition spacing, repetition scheduling, spaced retrieval and expanded retrieval. The use of spaced repetition has been shown to increase the rate of learning. Although the principle is useful in many contexts, spaced repetition is commonly applied in contexts in which a learner must acquire many items and retain them indefinitely in memory. It is therefore well suited for the problem of vocabulary acquisition in the course of second language learning, due to the size of the target language's inventory of open-class words.",
  "model": "openai/gpt-4"
}

### 6.2 Generate with Default Model
POST {{baseUrl}}/api/generations HTTP/1.1
Content-Type: application/json

{
  "source_text": "Active recall is a principle of efficient learning, which claims that memory is better when actively trying to retrieve information from memory. This is in contrast to passive review, in which information is merely re-read or re-watched. The testing effect is the finding that long-term memory is often increased when some of the learning period is devoted to retrieving the to-be-remembered information through testing with proper feedback. Active recall has been studied extensively in both classroom and laboratory settings. The use of active recall in learning has been shown to be more effective than passive review methods such as re-reading or highlighting. When using active recall, learners are forced to retrieve information from memory, which strengthens the memory trace and makes it more resistant to forgetting. This process is known as retrieval practice, and it is one of the most effective learning strategies available.",
  "model": "openai/gpt-3.5-turbo"
}

### 6.3 Generate - Test Validation (text too short - should fail)
POST {{baseUrl}}/api/generations HTTP/1.1
Content-Type: application/json

{
  "source_text": "This text is way too short to generate meaningful flashcards. It should fail validation because it doesn't meet the minimum character requirement of 1000 characters.",
  "model": "openai/gpt-4"
}

### 6.4 Generate - Test Validation (text too long - should fail)
# Note: This would need a text longer than 10000 characters
POST {{baseUrl}}/api/generations HTTP/1.1
Content-Type: application/json

{
  "source_text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit...[text over 10000 chars]",
  "model": "openai/gpt-4"
}

###############################################################################

### 7.1 Bulk Create Flashcards - POST /api/flashcards/bulk
# Note: Use generation_id from previous generation response
# @name bulkCreateFlashcards
POST {{baseUrl}}/api/flashcards/bulk HTTP/1.1
Content-Type: application/json

{
  "generation_id": {{generateFlashcards.response.body.$.generation_id}},
  "flashcards": [
    {
      "front": "What is spaced repetition?",
      "back": "A learning technique that incorporates increasing intervals of time between subsequent review",
      "source": "ai-full"
    },
    {
      "front": "What is the spacing effect?",
      "back": "The phenomenon whereby learning is greater when studying is spread out over time",
      "source": "ai-edited"
    },
    {
      "front": "What are alternative names for spaced repetition?",
      "back": "Spaced rehearsal, expanding rehearsal, graduated intervals, repetition spacing",
      "source": "ai-full"
    }
  ]
}

### 7.2 Bulk Create - Test Validation (invalid source - should fail)
POST {{baseUrl}}/api/flashcards/bulk HTTP/1.1
Content-Type: application/json

{
  "generation_id": 1,
  "flashcards": [
    {
      "front": "Test",
      "back": "Test",
      "source": "manual"
    }
  ]
}

### 7.3 Bulk Create - Test Validation (empty array - should fail)
POST {{baseUrl}}/api/flashcards/bulk HTTP/1.1
Content-Type: application/json

{
  "generation_id": 1,
  "flashcards": []
}

### 7.4 Bulk Create - Test Validation (non-existent generation - should fail)
POST {{baseUrl}}/api/flashcards/bulk HTTP/1.1
Content-Type: application/json

{
  "generation_id": 99999,
  "flashcards": [
    {
      "front": "Test",
      "back": "Test",
      "source": "ai-full"
    }
  ]
}

